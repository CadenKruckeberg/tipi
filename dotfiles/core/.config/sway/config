# --- Services ---
exec gtk-launch org.kde.polkit-kde-authentication-agent-1 # this works fine but it could look better
exec dunst
exec swayidle -w \
    timeout 270 'brightnessctl -s set 10%' \
    resume 'brightnessctl -r' \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 000000'

# --- Variables ---
set $mod Mod4
set $terminal alacritty
set $fileManager thunar
set $menu fuzzel

# --- General ---
bindsym $mod+r reload
bindsym $mod+space exec $menu
bindsym $mod+q kill
bindsym $mod+m exit
bindsym $mod+e exec $fileManager
bindsym --release Print exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+g exec pkill waybar || waybar

# --- Focus movement ---
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
mouse_warping container

# --- Mouse ---
floating_modifier $mod

# --- Workspace switching ---
bindsym $mod+h workspace number 1
bindsym $mod+j workspace number 2
bindsym $mod+k workspace number 3
bindsym $mod+l workspace number 4
bindsym $mod+semicolon workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# --- Move container to workspace ---
bindsym $mod+Shift+h move container to workspace number 1
bindsym $mod+Shift+j move container to workspace number 2
bindsym $mod+Shift+k move container to workspace number 3
bindsym $mod+Shift+l move container to workspace number 4
bindsym $mod+Shift+semicolon move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10


bindsym XF86AudioRaiseVolume exec pamixer -i 5 && paplay ~/.nix-profile/share/mint-artwork/sounds/volume.oga
bindsym XF86AudioLowerVolume exec pamixer -d 5 && paplay ~/.nix-profile/share/mint-artwork/sounds/volume.oga
bindsym XF86AudioMute exec pamixer -t
bindsym XF86AudioMicMute exec pamixer --default-source -t
bindsym XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous


# --- Window Styling and Sizing ---
default_border normal none
default_floating_border normal none
hide_edge_borders both
font pango:System-ui 1
titlebar_padding 1 1

# --- Color Scheme (Active White / Inactive Black) ---
# class           border  backgr. text    indicator child_border
client.focused    #40a02b #40a02b #40a02b #40a02b   #40a02b
client.unfocused  #225517 #225517 #225517 #225517   #225517

include $XDG_CONFIG_HOME/sway/theme.conf

seat seat0 xcursor_theme Vanilla-DMZ-AA 24

input "1133:49298:Logitech_G203_LIGHTSYNC_Gaming_Mouse" {
    accel_profile "flat"
    pointer_accel 0.0
  }

include "$(test -d /etc/sway/config.d && echo /etc/sway/config.d/* || true)"

input "type:touchpad" {
    natural_scroll enabled
    scroll_factor 0.3
    tap enabled
 }
